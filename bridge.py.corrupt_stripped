# ── Helpers ──────────────────────────────────────────────────────────────
def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] {msg}")
    with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "bridge.log"), "a") as f:
        f.write(f"[{ts}] {msg}\n")

def append_jsonl(path, obj):
    with open(path, "a") as f:
        f.write(json.dumps(obj, default=str) + "\n")

def read_jsonl(path):
    items = []
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        items.append(json.loads(line))
                    except json.JSONDecodeError:
                        pass
    return items

# ── Market Data ──────────────────────────────────────────────────────────
def get_price_range(symbol, since_ts):
    try:
        url = "https://data-api.binance.vision/api/v3/klines"
        params = {"symbol": symbol, "interval": "1h", "startTime": int(since_ts * 1000), "limit": 100}
        r = requests.get(url, params=params, timeout=10)
        r.raise_for_status()
        klines = r.json()
        if not klines:
            return None, None
        highs = [float(k[2]) for k in klines]
        lows = [float(k[3]) for k in klines]
        return max(highs), min(lows)
    except Exception as e:
        log(f"[RANGE] Error: {e}")
        return None, None

def get_atr(symbol, period=14):
    try:
        url = "https://data-api.binance.vision/api/v3/klines"
        params = {"symbol": symbol, "interval": "15m", "limit": period + 1}
        r = requests.get(url, params=params, timeout=10)
        r.raise_for_status()
        klines = r.json()
        if len(klines) < period + 1:
            return None
        trs = []
        for i in range(1, len(klines)):
            h = float(klines[i][2])
            l = float(klines[i][3])
            c = float(klines[i - 1][4])
            trs.append(max(h - l, abs(h - c), abs(l - c)))
        return sum(trs) / len(trs)
    except Exception as e:
        log(f"[ATR] {symbol}: {e}")
        return None

def get_market_data():
    try:
        url = "https://data-api.binance.vision/api/v3/ticker/24hr"
        r = requests.get(url, timeout=10)
        r.raise_for_status()
        tickers = r.json()
        usdt_pairs = [t for t in tickers if t["symbol"].endswith("USDT")]
        usdt_pairs.sort(key=lambda x: float(x.get("quoteVolume", 0)), reverse=True)
        reject_set = {"EUL", "BTC", "ETH", "USDT", "BUSD", "TUSD", "USDC", "USD1", "FDUSD", "PYUSD", "USDE", "DAI"}
        top20_dict = {}
        for t in usdt_pairs:
            sym = t["symbol"]
            base = sym.replace("USDT", "")
            vol = float(t.get("quoteVolume", 0))
            if base in reject_set or vol < 1_000_000:
                continue
            top20_dict[base] = {
                "symbol": sym,
                "price": float(t["lastPrice"]),
                "change_24h": float(t["priceChangePercent"]),
                "volume_24h": vol,
            }
            if len(top20_dict) >= 20:
                break
        return top20_dict
    except Exception as e:
        log(f"[MARKET] Error: {e}")
        return {}

