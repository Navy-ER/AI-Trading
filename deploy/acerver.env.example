# Template .env untuk acerver (/home/server/trading-bot/.env).
# Copy ke server lalu isi nilainya. JANGAN commit file .env yang sudah terisi.
# Ambil daftar key dari server: grep -hoE '^[A-Z0-9_]+=' .env | sort -u

# --- Mode trading ---
# WAJIB eksplisit: "1"/"true" = DRY_RUN, "0"/"false" = LIVE.
# Kalau kosong / nilai aneh, execution.py menganggap REJECTED (tidak trading).
TKO_DRY_RUN=1

# --- AI provider (Groq primary, Gemini + fallback opsional) ---
AI_MODEL=
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
GEMINI_API_KEY=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_AI_MODEL=
OMNIROUTER_URL=
OMNIROUTER_API_KEY=
FALLBACK_AI_URL=
FALLBACK_AI_KEY=
FALLBACK_AI_MODEL=

# --- Discord ---
DISCORD_WEBHOOK_URL=
DISCORD_TRADE_WEBHOOK_URL=

# --- Exchange (Tokocrypto) ---
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_SECRET_KEY=

# --- Ukuran & proteksi ---
TKO_MIN_ORDER_USDT=1.20
TKO_MAX_POSITION_USDT=5.00
TKO_MAX_SLOTS=5
TKO_TP_PCT=3
TKO_SL_PCT=1.5
TKO_CONFIDENCE_MIN=80

# --- Filter sinyal ---
TKO_ADX_MIN=20
TKO_ADX_MAX=65
TKO_BUY_ADX_MAX=65
TKO_BUY_RSI_MAX=70
TKO_TREND_ALIGN=0
TKO_TREND_MIN_ADX=25
TKO_LOSS_COOLDOWN_HOURS=6

# --- Circuit breaker ---
TKO_DAILY_LOSS_LIMIT=2.40
TKO_CIRCUIT_DISABLED=0
TKO_MAX_CONSECUTIVE_LOSSES=4
TKO_STREAK_COOLDOWN_HOURS=2

# --- Observability (baru) ---
# Alert kalau sekian cycle berturut-turut semua kandidat ditolak filter.
TKO_REJECT_ALERT_STREAK=6

TZ=Asia/Jakarta
